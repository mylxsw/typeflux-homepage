{
  "name": "typeflux-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:billing-coverage": "vitest --run --coverage --coverage.include=src/lib/billingApi.js --coverage.include=src/components/BillingPlansPage.jsx --coverage.include='src/components/billing/*.{js,jsx}' --coverage.exclude='src/components/billing/*.test.*' --coverage.include=src/components/billingInsights.js --coverage.reporter=text --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.statements=80 --coverage.thresholds.branches=80",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test:auth-coverage": "vitest run --coverage --coverage.include=src/lib/authApi.js --coverage.include=src/lib/authNavigation.js --coverage.include=src/lib/password.js --coverage.include=src/components/auth/*.js --coverage.include=src/components/auth/*.jsx --coverage.exclude=src/components/auth/*.test.jsx --coverage.reporter=text --coverage.reporter=json-summary --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90 --coverage.thresholds.branches=90",
    "test:account-coverage": "vitest run --coverage --coverage.include=src/lib/accountApi.js --coverage.include=src/lib/accountNavigation.js --coverage.include=src/contexts/AccountSessionContext.jsx --coverage.include=src/components/account/*.js --coverage.include=src/components/account/*.jsx --coverage.include=src/components/billing/useBillingAccess.js --coverage.exclude=src/components/account/*.test.* --coverage.exclude=src/components/account/testUtils.jsx --coverage.reporter=text --coverage.thresholds.lines=90 --coverage.thresholds.functions=90 --coverage.thresholds.statements=90 --coverage.thresholds.branches=90"
  },
  "dependencies": {
    "@emnapi/core": "^1.9.2",
    "@emnapi/runtime": "^1.9.2",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.0.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "packageManager": "npm@11.19.0"
}
