# Vite forwards /api, /d/, and /go/ to the local API without changing paths.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Keep this empty for same-origin requests through the development proxy.
VITE_API_BASE_URL=

# Enable only after the HTTPS same-origin web-auth proxy and API are ready.
VITE_WEB_AUTH_ENABLED=false
# Exact App redirect bases. Add a development scheme only on the test origin.
VITE_WEB_AUTH_APP_REDIRECTS=ai.gulu.app.typeflux://auth/callback
