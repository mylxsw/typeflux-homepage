{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "typeflux-homepage",
  "main": "deploy/worker.mjs",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/v1/auth/*", "/login", "/login/*",
      "/zh-CN/login", "/zh-CN/login/*", "/zh-TW/login", "/zh-TW/login/*",
      "/ja/login", "/ja/login/*", "/ko/login", "/ko/login/*", "/auth", "/auth.html"
    ]
  }
}
