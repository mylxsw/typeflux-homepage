{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "typeflux-homepage",
  "main": "deploy/worker.mjs",
  "compatibility_date": "2026-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/go/*", "/d/*",
      "/zh-CN/go/*", "/zh-TW/go/*", "/ja/go/*", "/ko/go/*",
      "/zh-CN/d/*", "/zh-TW/d/*", "/ja/d/*", "/ko/d/*", "/login", "/login/*",
      "/zh-CN/login", "/zh-CN/login/*", "/zh-TW/login", "/zh-TW/login/*",
      "/ja/login", "/ja/login/*", "/ko/login", "/ko/login/*", "/auth", "/auth.html"
    ]
  }
}
